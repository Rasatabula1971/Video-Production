# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment & credentials — never commit
.env
.env.local
*.env
.youtube-token.json
*-service-account.json
service_account*.json
gcp-*.json

# Pipeline outputs — ignore generated media/corpus, but KEEP the decision-trail
# artifacts (schema-valid JSON + notes). Those are the record, per the ledger
# philosophy in docs/PLAN_v1.md.
output/
corpus/
**/corpus/
music_library/
runs/
*.mp4
*.mov
*.wav
*.mp3
*.png
*.jpg
*.onnx
projects/**/renders/
projects/**/assets/
projects/**/audio/
!vendor/openmontage/**/demo-props/**
!projects/**/*.json
!projects/**/*.md
!projects/**/*.yaml

# Local model downloads (Piper voices etc., fetched at runtime)
*.onnx
*.onnx.json

# Node
node_modules/
vendor/openmontage/remotion-composer/out/
vendor/openmontage/remotion-composer/projects/

# Ledger database (local, regenerable structure but holds run history —
# decide before committing; ignored for now)
montage_ext/ledger/*.sqlite
montage_ext/ledger/*.db

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
