{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "video-production/brands/brand",
  "title": "Brand Kit (video-relevant subset)",
  "description": "The parts of a brand kit the video production system consumes. Authored by the brand-intake conversation. Strategy before visuals: foundation and messaging first, then the visual language that expresses them.",
  "type": "object",
  "required": ["version", "id", "status", "foundation", "messaging", "voice", "visual", "content_strategy", "platforms", "ai_content_policy"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "status": { "type": "string", "enum": ["pending_intake", "draft", "approved"] },

    "foundation": {
      "type": "object",
      "required": ["what_we_do", "target_customer", "customer_problem", "positioning", "brand_promise", "core_values", "personality", "desired_perception"],
      "properties": {
        "what_we_do": { "type": "string", "description": "One clear sentence." },
        "target_customer": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "customer_problem": { "type": "string" },
        "positioning": { "type": "string", "description": "Why choose this brand over alternatives." },
        "brand_promise": { "type": "string" },
        "core_values": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 5 },
        "personality": { "type": "array", "items": { "type": "string" }, "description": "e.g. premium, technical, friendly, bold, traditional" },
        "desired_perception": { "type": "string", "description": "What people should think/feel on contact." },
        "tagline": { "type": "string" }
      },
      "additionalProperties": false
    },

    "messaging": {
      "type": "object",
      "required": ["one_line", "thirty_second", "value_proposition", "key_messages"],
      "properties": {
        "one_line": { "type": "string" },
        "thirty_second": { "type": "string" },
        "full_description": { "type": "string" },
        "value_proposition": { "type": "string" },
        "key_messages": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 5 },
        "customer_pain_points": { "type": "array", "items": { "type": "string" } },
        "reasons_to_believe": { "type": "array", "items": { "type": "string" }, "description": "Proof points: results, testimonials, process, guarantees, expertise" },
        "calls_to_action": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },

    "voice": {
      "type": "object",
      "required": ["tone", "words_to_use", "words_to_avoid", "hard_fail_rules"],
      "properties": {
        "tone": { "type": "string" },
        "tone_by_context": {
          "type": "object",
          "description": "Optional per-context tone (education, promotion, community reply, etc.)",
          "additionalProperties": { "type": "string" }
        },
        "words_to_use": { "type": "array", "items": { "type": "string" } },
        "words_to_avoid": { "type": "array", "items": { "type": "string" } },
        "hard_fail_rules": {
          "type": "array",
          "description": "Statements a script must never make. The hook_scorer fails any script that violates one. Brand-level; subjects add their own.",
          "items": {
            "type": "object",
            "required": ["rule", "why"],
            "properties": { "rule": { "type": "string" }, "why": { "type": "string" } },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "visual": {
      "type": "object",
      "required": ["palette", "typography", "motion", "must_never_appear"],
      "properties": {
        "palette": {
          "type": "object",
          "required": ["ink", "paper", "accent"],
          "properties": {
            "ink": { "type": "string" }, "paper": { "type": "string" },
            "accent": { "type": "string" }, "accent_secondary": { "type": "string" },
            "positive": { "type": "string" }, "negative": { "type": "string" },
            "usage_rules": { "type": "string" }
          },
          "additionalProperties": false
        },
        "typography": {
          "type": "object",
          "required": ["display", "body"],
          "properties": {
            "display": { "type": "string" }, "body": { "type": "string" },
            "accent": { "type": "string" },
            "capitalization": { "type": "string" },
            "web_safe_fallback": { "type": "string" },
            "license_note": { "type": "string" }
          },
          "additionalProperties": false
        },
        "motion": {
          "type": "object",
          "required": ["vocabulary", "pacing_rules"],
          "properties": {
            "vocabulary": { "type": "array", "items": { "type": "string" } },
            "pacing_rules": { "type": "array", "items": { "type": "string" }, "description": "e.g. max 3s static hold; visible change every 1-2s; one slow camera move per scene" },
            "render_runtime_preference": { "type": "string", "enum": ["hyperframes", "remotion", "auto"] }
          },
          "additionalProperties": false
        },
        "imagery_style": { "type": "string", "description": "Photography/video style, lighting, grading, composition." },
        "must_never_appear": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "end_tag": {
          "type": "object",
          "properties": { "line": { "type": "string" }, "mode": { "type": "string", "enum": ["overlay", "concat"] } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "content_strategy": {
      "type": "object",
      "required": ["pillars", "caption_structure", "cta_rules", "cadence"],
      "properties": {
        "pillars": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 5 },
        "pillar_mix_notes": { "type": "string" },
        "caption_structure": { "type": "string" },
        "cta_rules": { "type": "string" },
        "hashtag_strategy": { "type": "string" },
        "community_reply_style": { "type": "string" },
        "cadence": {
          "type": "object",
          "required": ["posts_per_week"],
          "properties": {
            "posts_per_week": { "type": "number" },
            "operator_capacity": { "type": "string" },
            "production_hours_per_week": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "priority"],
        "properties": {
          "name": { "type": "string", "enum": ["youtube_shorts", "tiktok", "instagram_reels", "youtube_long", "facebook", "linkedin"] },
          "role": { "type": "string", "description": "Purpose and audience for this platform." },
          "priority": { "type": "string", "enum": ["primary", "secondary", "later"] },
          "aspect_ratio": { "type": "string" },
          "duration_seconds_default": { "type": "number" },
          "safe_area_note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "audience": {
      "type": "object",
      "description": "Who the BRAND serves. Subjects narrow this to who cares about a given topic.",
      "properties": {
        "serves": { "type": "array", "items": { "type": "string" } },
        "not_the_audience": { "type": "array", "items": { "type": "string" } },
        "reach_signal_notes": { "type": "string" }
      },
      "additionalProperties": false
    },

    "ai_content_policy": {
      "type": "object",
      "required": ["ai_voice", "ai_imagery", "ai_writing", "human_review"],
      "properties": {
        "ai_voice": { "type": "string", "description": "Allowed? Which providers? Disclosure?" },
        "ai_imagery": { "type": "string" },
        "ai_writing": { "type": "string" },
        "human_review": { "type": "string", "description": "What a human must approve before publish." },
        "disclosure": { "type": "string" }
      },
      "additionalProperties": false
    },

    "measurement": {
      "type": "object",
      "properties": {
        "metrics": { "type": "array", "items": { "type": "string" } },
        "winner_rule": { "type": "string" }
      },
      "additionalProperties": false
    },

    "assets": {
      "type": "object",
      "properties": {
        "logo_files": { "type": "array", "items": { "type": "string" } },
        "template_files": { "type": "array", "items": { "type": "string" } },
        "music_library_moods": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
