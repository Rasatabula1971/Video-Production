  "cuts": [
    {
      "id": "hook",
      "source": "",
      "type": "hero_title",
      "in_seconds": 0,
      "out_seconds": 5.0,
      "text": "That spider web isn't decoration.",
      "heroSubtitle": "It's a map.",
      "backgroundColor": "#0F172A"
    },
    {
      "id": "setup",
      "source": "",
      "type": "text_card",
      "in_seconds": 5.0,
      "out_seconds": 13.1,
      "text": "Every note is on the SAME sheet of steel.\nClashing notes side by side would buzz.",
      "color": "#F8FAFC",
      "backgroundColor": "#0F172A"
    },
    {
      "id": "build",
      "source": "",
      "type": "comparison",
      "in_seconds": 13.1,
      "out_seconds": 20.4,
      "title": "So the layout splits them up",
      "leftLabel": "Clashing notes",
      "leftValue": "opposite sides",
      "rightLabel": "Friendly notes",
      "rightValue": "side by side",
      "backgroundColor": "#0F172A"
    },
    {
      "id": "payoff",
      "source": "",
      "type": "text_card",
      "in_seconds": 20.4,
      "out_seconds": 26.5,
      "text": "That's why a steelpan rings clean instead of rattling.",
      "color": "#F8FAFC",
      "backgroundColor": "#0F172A"
    },
    {
      "id": "landing",
      "source": "",
      "type": "text_card",
      "in_seconds": 26.5,
      "out_seconds": 31.0,
      "text": "Anthony Williams worked it out.\nTrinidad, 1953.",
      "color": "#F8FAFC",
      "backgroundColor": "#0F172A"
    },
    {
      "id": "endtag",
      "source": "",
      "type": "hero_title",
      "in_seconds": 31.0,
      "out_seconds": 35.6,
      "text": "Every lead pan still follows his drawing.",
      "heroSubtitle": "Pan. Made in Trinidad.",
      "backgroundColor": "#0F172A"
    }
  ],
